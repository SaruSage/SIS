rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /codigosAdesao/{documento} {
      allow read, update: if true;
      allow create, delete: if request.auth != null;
    }

    match /solicitacoes/{documento} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    function somenteBackend(colecao, caminhoDocumento) {
      return colecao == "whatsappNumbers" ||
        colecao == "whatsappJobs" ||
        colecao == "whatsappWebhookEvents" ||
        (colecao == "cards" &&
          caminhoDocumento.matches('^.*/mensagensWhatsapp/[^/]+$'));
    }

    match /{colecao}/{caminhoDocumento=**} {
      allow read, write: if request.auth != null &&
        !somenteBackend(colecao, caminhoDocumento);
    }
  }
}
